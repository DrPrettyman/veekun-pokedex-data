  "heldEffects": {
    "_description": "Passive effects when held by a Pokemon. Each effect has a 'trigger' (when it activates), an 'effect' (what it does), optional 'args', and optional 'oneShot' (consumed after activation). Items may have 'speciesIds' to restrict to specific species.",
    "_triggers": {
      "passive": "Always active — modifies stats, type damage, evasion, crit rate, etc.",
      "turnEnd": "Activates at end of each turn",
      "afterAttack": "Activates after holder attacks",
      "onHit": "Activates when holder is hit by an attack",
      "onLowHp": "Activates when HP drops to/below threshold — args: {threshold: fraction}",
      "onStatus": "Activates when holder is afflicted with a status condition",
      "onPpDepleted": "Activates when a move reaches 0 PP",
      "onStatDrop": "Activates when holder's stats are lowered",
      "onAttract": "Activates when holder is infatuated"
    },
    "_effects": {
      "typeBoost": "args: {typeId: number, multiplier: number} — multiplies damage for moves of that type",
      "statMultiplier": "args: {statId: number, multiplier: number} — multiplies a stat value",
      "hpRestore": "args: {amount: number|'eighth'|'sixteenth'|'quarter'} — restore HP",
      "ppRestore": "args: {amount: number} — restore PP to depleted move",
      "statusCure": "args: {statusIds: number[]} — cure listed status conditions",
      "statBoost": "args: {statId: number|'random', stages: number} — boost stat stage(s)",
      "critBoost": "args: {stages: number} — boost crit stage",
      "accuracyReduction": "args: {amount: number} — reduce opponent's accuracy (fraction, e.g. 0.1 = 10%)",
      "flinchChance": "args: {chance: number} — add flinch chance to non-flinch moves (fraction)",
      "speedPriority": "args: {chance: number} — chance to move first regardless of speed (fraction)",
      "surviveHit": "args: {chance: number} — chance to survive a KO at 1 HP (fraction)",
      "drainHp": "args: {fraction: number} — restore fraction of damage dealt as HP",
      "resetStats": "no args — reset all negative stat changes to 0",
      "evMultiplier": "args: {multiplier: number} — multiply EV gains from battle",
      "speedHalve": "no args — halve speed in battle",
      "expMultiplier": "args: {multiplier: number} — multiply exp gained",
      "expShare": "no args — gain exp share from battle without fighting",
      "happinessMultiplier": "args: {multiplier: number} — multiply happiness gains",
      "moneyMultiplier": "args: {multiplier: number} — multiply prize money from trainer battles",
      "encounterReduction": "no args — reduce wild encounter rate",
      "preventEvolution": "no args — block evolution",
      "guaranteeFlee": "no args — always flee from wild battles",
      "moveLock": "no args — lock into first move used (paired with stat multiplier)",
      "contestBoost": "args: {conditionId: number} — boost contest performance for a condition"
    },

