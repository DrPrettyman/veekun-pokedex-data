  "overworldEffects": {
    "_description": "Effects on the overworld/game state, not applied to a specific Pokemon.",
    "_effects": {
      "repel": "args: {steps: number} — prevents wild encounters below lead Pokemon's level for N steps",
      "escape": "no args — teleport out of cave/dungeon",
      "encounterRate": "args: {modifier: 'decrease'|'increase'} — modifies wild encounter rate while in area"
    },
