  "battleEffects": {
    "_description": "Effects that affect the battle itself, not applied to a specific Pokemon. pokeballs.ts handles the 'catch' effect.",
    "_effects": {
      "catch": "args: Ball catch formula params. 'ball_multiplier' is the flat value. 'catch_override: true' bypasses the formula (guaranteed catch). For conditional balls: 'ball_multiplier_bonus' when 'condition' is met. For scaling balls: 'ball_multiplier_min'/'ball_multiplier_max' with 'scale_by' and 'scale_range' [low, high]. 'passive' for non-catch effects (e.g. happiness-200).",
      "flee": "no args — ends a wild battle"
    },
    "1":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"catch_override": true}}]},
    "2":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier": 2.0}}]},
    "3":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier": 1.5}}]},
    "4":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier": 1.0}}]},
