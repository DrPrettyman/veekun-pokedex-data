    "6":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier": 1.0, "ball_multiplier_bonus": 3.0, "condition": "target-is-water-or-bug-type"}}]},
    "7":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier": 1.0, "ball_multiplier_bonus": 3.5, "condition": "fishing-or-surfing"}}]},
    "8":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier_min": 1.0, "ball_multiplier_max": 3.9, "scale_by": "target-level", "scale_range": [1, 30]}}]},
    "9":   {"battleType": "wild", "effects": [{"effect": "catch", "args": {"ball_multiplier": 1.0, "ball_multiplier_bonus": 3.0, "condition": "target-previously-caught"}}]},
