{
  "pokemonEffects": {
    "_description": "Effects applied to a Pokemon. Each item has: target (which Pokemon), optional battleOnly flag (only usable in battle), optional reusable flag, and an effects array. Each effect has an 'effect' name and optional 'args'.",
    "_targets": {
      "partyMember": "User picks any party member (medicine, vitamins, PP items, EV berries, evo stones)",
      "playerActive": "Targets the active battler (X Attack, Dire Hit, Guard Spec, Yellow/Red Flute)",
      "allFaintedParty": "Targets all fainted party members (Sacred Ash)"
    },
    "_effects": {
      "hpRestore": "args: {amount: number|'full'}",
      "statusCure": "args: {statusIds: number[]} — veekun ailment IDs: 1=paralysis, 2=sleep, 3=freeze, 4=burn, 5=poison, 6=confusion",
      "revive": "args: {hpFraction: number} — 0.5=half HP, 1.0=full HP",
      "ppRestore": "args: {scope: 'one'|'all', amount: number|'full'}",
      "evBoost": "args: {statId: number, amount: number, cap: number}",
      "evReduce": "args: {statId: number, amount: number, threshold: number} — if EV > threshold, set to threshold; else reduce by amount; no effect if EV = 0",
      "levelUp": "no args",
      "ppMaxBoost": "args: {stages: number} — PP Up=1, PP Max=3",
      "statBoost": "args: {statId: number, stages: number} — battleOnly",
      "critBoost": "args: {stages: number} — battleOnly",
      "guardSpec": "no args — prevents stat drops for 5 turns — battleOnly",
      "happiness": "args: {amount: [low, mid, high]} — secondary effect, only applied if a primary effect succeeds",
      "cureVolatile": "args: {condition: 'sleep'|'confusion'|'attraction'}",
      "evolve": "no args — triggers use-item evolution if species has one for this item",
      "teachMove": "args: {moveId: number} — generated from machines data in generate.py for TMs/HMs"
    },
